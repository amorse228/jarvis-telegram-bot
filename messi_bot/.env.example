# Скопируй этот файл в .env и заполни. Файл .env в git НЕ попадает.

# Токен бота от @BotFather
BOT_TOKEN=

# Ключ Claude API (https://platform.claude.com/ → API Keys)
ANTHROPIC_API_KEY=

# Telegram id семьи
OWNER_ID=1270318984
GIRLFRIEND_ID=5197933099

# Как Месси обращается к каждому
OWNER_NAME=папа
GIRLFRIEND_NAME=мама

# Часовой пояс (для «доброе утро» и тихих часов ночью)
TIMEZONE=Europe/Moscow

# Модель и глубина размышлений (low / medium / high)
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=medium

# Месси сама пишет первой (1 — да, 0 — нет) и сколько раз в день максимум
PROACTIVE_MESSAGES=1
PROACTIVE_MAX_PER_DAY=3
